# Copy this file to .env.local and fill in your own Supabase project values.
# Never commit .env.local — it is already ignored by .gitignore.
# These EXPO_PUBLIC_* vars are bundled into the client app; only put the
# anon/public key here, never the Supabase service_role key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
